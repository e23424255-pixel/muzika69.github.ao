<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MyMusic — плеер</title>
<style>
:root{
  --bg:#0a0b0f; --panel:#111319; --card:#161922; --card-h:#1d212c;
  --text:#f4f5f8; --muted:#868da1; --accent:#ffdb4d; --line:#22262f;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font:15px/1.45 Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
.wrap{display:grid;grid-template-columns:248px 1fr;height:100vh;padding-bottom:92px}

/* ---------- сайдбар ---------- */
.side{border-right:1px solid var(--line);padding:18px 12px;overflow:auto;background:var(--panel)}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;padding:4px 10px 16px}
.logo i{width:26px;height:26px;border-radius:8px;background:var(--accent);display:grid;place-items:center;
  color:#111;font-style:normal;font-weight:900}
.side h4{margin:16px 10px 8px;font-size:11px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
.pl{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border-radius:10px;text-align:left}
.pl:hover{background:var(--card)}
.pl.on{background:var(--card-h)}
.pl .dot{width:34px;height:34px;border-radius:9px;flex:0 0 auto;display:grid;place-items:center;
  font-size:15px;color:#0b0c10;font-weight:700}
.pl span{font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ---------- контент ---------- */
main{overflow:auto;padding:22px 26px}
.top{display:flex;gap:12px;align-items:center;margin-bottom:20px;flex-wrap:wrap}
.search{flex:1;min-width:220px;max-width:460px;display:flex;align-items:center;gap:8px;
  background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 14px}
.search input{flex:1;background:none;border:0;outline:0;color:var(--text);font:inherit}
.btn{background:var(--card);border:1px solid var(--line);border-radius:11px;padding:10px 14px;color:var(--muted)}
.btn:hover{background:var(--card-h);color:var(--text)}
.btn.on{color:var(--accent);border-color:#3a3a20}

.hero{display:flex;gap:20px;align-items:flex-end;margin-bottom:22px;flex-wrap:wrap}
.cover{width:170px;height:170px;border-radius:16px;flex:0 0 auto;display:grid;place-items:center;
  font-size:56px;font-weight:900;color:#0b0c10}
.hero h1{margin:0 0 6px;font-size:34px;line-height:1.1}
.hero p{margin:0;color:var(--muted)}
.play{background:var(--accent);color:#0b0c10;border-radius:999px;padding:11px 26px;font-weight:700;margin-top:14px}
.play:hover{filter:brightness(1.07)}

.tracks{margin-top:8px}
.tr{display:grid;grid-template-columns:38px 1fr auto auto;gap:14px;align-items:center;
  padding:9px 12px;border-radius:10px;cursor:pointer}
.tr:hover{background:var(--card)}
.tr.on{background:var(--card-h)}
.tr .n{color:var(--muted);text-align:right;font-variant-numeric:tabular-nums}
.tr.on .n{color:var(--accent)}
.tr .t{overflow:hidden}
.tr .t b{display:block;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tr .t small{color:var(--muted)}
.tr .d{color:var(--muted);font-variant-numeric:tabular-nums}
.empty{color:var(--muted);padding:26px 4px}

/* ---------- плеер ---------- */
.player{position:fixed;left:0;right:0;bottom:0;height:92px;background:var(--panel);
  border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 2fr 1fr;
  gap:18px;align-items:center;padding:0 20px}
.now{display:flex;align-items:center;gap:12px;min-width:0}
.now .cov{width:52px;height:52px;border-radius:10px;flex:0 0 auto;display:grid;place-items:center;
  color:#0b0c10;font-weight:800}
.now b,.now small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.now small{color:var(--muted)}
.ctrl{display:flex;flex-direction:column;align-items:center;gap:8px}
.btns{display:flex;align-items:center;gap:14px}
.ib{font-size:18px;color:var(--muted);padding:4px;line-height:1}
.ib:hover{color:var(--text)}
.ib.on{color:var(--accent)}
.ib.big{width:42px;height:42px;border-radius:50%;background:var(--accent);color:#0b0c10;
  display:grid;place-items:center}
.bar{display:flex;align-items:center;gap:10px;width:100%;font-size:12px;color:var(--muted)}
.seek,.vol{height:5px;background:#2a2f3a;border-radius:99px;position:relative;cursor:pointer}
.seek{flex:1}
.seek i,.vol i{position:absolute;top:0;bottom:0;left:0;width:0;background:var(--accent);border-radius:99px}
.seek:hover i{background:#ffe375}
.right{display:flex;align-items:center;gap:12px;justify-content:flex-end}
.vol{width:110px}
.vol i{background:#fff;width:80%}

@media(max-width:820px){
  .wrap{grid-template-columns:1fr;padding-bottom:158px}
  .side{display:none}
  .player{grid-template-columns:1fr;height:auto;padding:12px 14px;gap:10px}
  .right{display:none}
  .hero h1{font-size:24px}
  .cover{width:120px;height:120px;font-size:40px}
}
</style>
</head>
<body>

<div class="wrap">
  <aside class="side">
    <div class="logo"><i>♪</i> MyMusic</div>
    <h4>Плейлисты</h4>
    <div id="plList"></div>
    <h4>Моя музыка</h4>
    <label class="pl" style="cursor:pointer">
      <span class="dot" style="background:#2a2f3a;color:#868da1">+</span>
      <span>Добавить файлы</span>
      <input id="fileInput" type="file" accept="audio/*" multiple hidden>
    </label>
  </aside>

  <main>
    <div class="top">
      <label class="search">🔍<input id="q" placeholder="Поиск по трекам и исполнителям"></label>
      <button class="btn" id="shuffleBtn">Перемешать</button>
    </div>
    <div id="view"></div>
  </main>
</div>

<audio id="audio" preload="metadata"></audio>

<footer class="player">
  <div class="now">
    <div class="cov" id="pCover">♪</div>
    <div style="min-width:0">
      <b id="pTitle">Ничего не играет</b>
      <small id="pArtist">Выбери трек</small>
    </div>
  </div>

  <div class="ctrl">
    <div class="btns">
      <button class="ib" id="prev" title="Предыдущий">⏮</button>
      <button class="ib big" id="playBtn" title="Играть / пауза">▶</button>
      <button class="ib" id="next" title="Следующий">⏭</button>
      <button class="ib" id="shuf" title="Случайный порядок">🔀</button>
      <button class="ib" id="rep" title="Повтор">🔁</button>
    </div>
    <div class="bar">
      <span id="tCur">0:00</span>
      <div class="seek" id="seek"><i id="seekFill"></i></div>
      <span id="tDur">0:00</span>
    </div>
  </div>

  <div class="right">🔊 <div class="vol" id="vol"><i id="volFill"></i></div></div>
</footer>

<script>
/* ==================== 1. КАТАЛОГ ТРЕКОВ ====================
   Положи свои mp3 в папку audio/ рядом с index.html
   или замени src на прямые ссылки. */
const LIB = [
  {
    id:'top', title:'Топ 100', grad:'linear-gradient(135deg,#ffdb4d,#ff7a00)',
    tracks:[
      {title:'Ночной город',   artist:'Demo Artist', src:'audio/1.mp3', dur:''},
      {title:'Летний дождь',   artist:'Demo Artist', src:'audio/2.mp3', dur:''},
      {title:'Танцуй со мной', artist:'Demo Artist', src:'audio/3.mp3', dur:''}
    ]
  },
  {
    id:'chill', title:'Chill', grad:'linear-gradient(135deg,#5eead4,#3b82f6)',
    tracks:[
      {title:'Медленное утро', artist:'Demo Artist', src:'audio/4.mp3', dur:''},
      {title:'Тёплый свет',    artist:'Demo Artist', src:'audio/5.mp3', dur:''}
    ]
  },
  {
    id:'rock', title:'Рок', grad:'linear-gradient(135deg,#f87171,#7c3aed)',
    tracks:[
      {title:'На полной',  artist:'Demo Artist', src:'audio/6.mp3', dur:''},
      {title:'Громче всех',artist:'Demo Artist', src:'audio/7.mp3', dur:''}
    ]
  }
];

/* ==================== 2. СОСТОЯНИЕ ==================== */
const audio   = document.getElementById('audio');
const view    = document.getElementById('view');
const plList  = document.getElementById('plList');
const qInput  = document.getElementById('q');

let curPl  = 0;      // выбранный плейлист
let queue  = [];     // треки, которые сейчас в воспроизведении
let qi     = -1;     // позиция в очереди
let shuffle = false;
let repeat  = false;

const grad = t => t.__g || 'linear-gradient(135deg,#ffdb4d,#ff7a00)';
const esc  = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt  = s => { if(!isFinite(s)) return '0:00';
  const m = Math.floor(s/60), x = Math.floor(s%60); return m + ':' + String(x).padStart(2,'0'); };

// проставляем градиент плейлиста каждому треку
LIB.forEach(p => p.tracks.forEach((t,i) => { t.__g = p.grad; t.__p = p.id; t.__i = i; }));

/* ==================== 3. РЕНДЕР САЙДБАРА ==================== */
function renderSide(){
  plList.innerHTML = LIB.map((p,i) => `
    <button class="pl ${i===curPl?'on':''}" data-pl="${i}">
      <span class="dot" style="background:${p.grad}">${i===curPl&&!audio.paused?'♪':''}</span>
      <span>${esc(p.title)}</span>
    </button>`).join('');
}

/* ==================== 4. РЕНДЕР КОНТЕНТА ==================== */
function renderView(){
  const q = qInput.value.trim().toLowerCase();
  let list, head;

  if(q){
    list = [];
    LIB.forEach(p => p.tracks.forEach((t,i) => {
      if((t.title+' '+t.artist).toLowerCase().includes(q)) list.push(t);
    }));
    head = {title:'Результаты поиска', sub:`Найдено: ${list.length}`, grad:'linear-gradient(135deg,#a78bfa,#ec4899)'};
  } else {
    const p = LIB[curPl];
    list = p.tracks;
    head = {title:p.title, sub:`${p.tracks.length} трек(ов)`, grad:p.grad};
  }

  view.innerHTML = `
    <div class="hero">
      <div class="cover" style="background:${head.grad}">♪</div>
      <div>
        <h1>${esc(head.title)}</h1>
        <p>${esc(head.sub)}</p>
        <button class="play" id="playAll">▶ Слушать</button>
      </div>
    </div>
    <div class="tracks" id="trackList">
      ${ list.length ? list.map((t,i) => `
        <div class="tr ${t===queue[qi]?'on':''}" data-idx="${i}">
          <div class="n">${t===queue[qi]?'♪':i+1}</div>
          <div class="t"><b>${esc(t.title)}</b><small>${esc(t.artist)}</small></div>
          <div class="d">${esc(t.dur||'')}</div>
          <div class="d">⋯</div>
        </div>`).join('')
      : `<div class="empty">Пусто. Проверь название или добавь свои файлы.</div>` }
    </div>`;

  document.getElementById('playAll').onclick = () => list.length && playQueue(list, 0);

  document.getElementById('trackList').onclick = e => {
    const row = e.target.closest('.tr');
    if(row) playQueue(list, +row.dataset.idx);
  };
}

/* ==================== 5. ВОСПРОИЗВЕДЕНИЕ ==================== */
function playQueue(list, i){
  queue = list; qi = i;
  const t = queue[qi];
  audio.src = t.src;
  audio.play().catch(() => {/* нет файла — просто ждём клика ещё раз */});
  paintNow(t);
  markActive();
}

function markActive(){
  const now = queue[qi];
  view.querySelectorAll('.tr').forEach(r => r.classList.toggle('on', queue[+r.dataset.idx] === now));
}

function paintNow(t){
  document.getElementById('pTitle').textContent  = t.title;
  document.getElementById('pArtist').textContent = t.artist;
  const c = document.getElementById('pCover');
  c.style.background = grad(t);
  c.textContent = t.title.trim()[0] ? t.title.trim()[0].toUpperCase() : '♪';
}

function next(step = 1){
  if(!queue.length) return;
  if(shuffle){ qi = Math.floor(Math.random()*queue.length); }
  else {
    qi += step;
    if(qi >= queue.length) qi = repeat ? 0 : queue.length - 1;
    if(qi < 0) qi = 0;
  }
  audio.src = queue[qi].src;
  audio.play().catch(()=>{});
  paintNow(queue[qi]);
  markActive();
}

/* ==================== 6. СОБЫТИЯ ПЛЕЕРА ==================== */
const playBtn = document.getElementById('playBtn');

playBtn.onclick = () => {
  if(!queue.length){ const p = LIB[curPl]; if(p.tracks.length) return playQueue(p.tracks,0); return; }
  audio.paused ? audio.play() : audio.pause();
};
document.getElementById('next').onclick = () => next(1);
document.getElementById('prev').onclick = () => (audio.currentTime > 3 ? audio.currentTime = 0 : next(-1));
document.getElementById('shuf').onclick = e => { shuffle = !shuffle; e.currentTarget.classList.toggle('on', shuffle); };
document.getElementById('rep').onclick  = e => { repeat  = !repeat;  e.currentTarget.classList.toggle('on', repeat);  };

audio.addEventListener('play',  () => { playBtn.textContent = '❚❚'; renderSide(); });
audio.addEventListener('pause', () => { playBtn.textContent = '▶';  renderSide(); });
audio.addEventListener('ended', () => repeat ? (audio.currentTime = 0, audio.play()) : next(1));

audio.addEventListener('loadedmetadata', () => {
  document.getElementById('tDur').textContent = fmt(audio.duration);
});
audio.addEventListener('timeupdate', () => {
  if(!audio.duration) return;
  document.getElementById('seekFill').style.width = (audio.currentTime/audio.duration*100) + '%';
  document.getElementById('tCur').textContent = fmt(audio.currentTime);
});

/* перемотка */
function ratio(el, e){ const r = el.getBoundingClientRect(); return Math.min(1, Math.max(0,(e.clientX-r.left)/r.width)); }
const seek = document.getElementById('seek');
seek.addEventListener('click', e => { if(audio.duration) audio.currentTime = ratio(seek,e)*audio.duration; });
const vol = document.getElementById('vol');
function setVol(e){
  const v = ratio(vol,e); audio.volume = v;
  document.getElementById('volFill').style.width = (v*100)+'%';
}
vol.addEventListener('click', setVol);

/* выбор плейлиста */
plList.addEventListener('click', e => {
  const b = e.target.closest('[data-pl]'); if(!b) return;
  curPl = +b.dataset.pl; qInput.value = '';
  renderSide(); renderView();
});

/* поиск */
qInput.addEventListener('input', renderView);

/* кнопка «перемешать» сверху */
document.getElementById('shuffleBtn').onclick = e => {
  shuffle = !shuffle;
  document.getElementById('shuf').classList.toggle('on', shuffle);
  e.currentTarget.classList.toggle('on', shuffle);
  if(shuffle && queue.length) next(1);
};

/* свои файлы с компьютера */
document.getElementById('fileInput').onchange = e => {
  const files = [...e.target.files];
  if(!files.length) return;
  const tracks = files.map(f => ({
    title: f.name.replace(/\.[^.]+$/,''),
    artist: 'Мои файлы',
    src: URL.createObjectURL(f),
    dur: ''
  }));
  tracks.forEach(t => t.__g = 'linear-gradient(135deg,#5eead4,#3b82f6)');
  LIB.unshift({
    id:'local'+Date.now(),
    title:'Мои файлы ('+tracks.length+')',
    grad:'linear-gradient(135deg,#5eead4,#3b82f6)',
    tracks
  });
  curPl = 0; qInput.value = '';
  renderSide(); renderView();
  playQueue(tracks, 0);
};

/* пробел — плей/пауза */
document.addEventListener('keydown', e => {
  if(e.code === 'Space' && !/INPUT|TEXTAREA/.test(e.target.tagName)){
    e.preventDefault(); playBtn.click();
  }
});

/* ==================== 7. СТАРТ ==================== */
renderSide();
renderView();
audio.volume = 0.8;
</script>
</body>
</html>
